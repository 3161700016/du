/**
 * 渡 · 聊天界面样式
 * 暗色主题，手机优先
 */

/* ── 容器 ────────────────────────────── */
.chat-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #0f0f1a;
}

/* ── 顶部栏 ──────────────────────────── */
.chat-header {
  padding: 24rpx 32rpx 16rpx;
  text-align: center;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
  flex-shrink: 0;
}
.header-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #c8d6e5;
  letter-spacing: 8rpx;
}
.header-subtitle {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.25);
  margin-top: 4rpx;
}

/* ── 消息列表 ────────────────────────── */
.msg-list {
  flex: 1;
  padding: 16rpx 24rpx;
  overflow-y: auto;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 30vh;
}
.empty-icon {
  font-size: 80rpx;
  margin-bottom: 32rpx;
  opacity: 0.6;
}
.empty-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #c8d6e5;
  margin-bottom: 24rpx;
}
.empty-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.35);
  text-align: center;
  line-height: 1.8;
  white-space: pre-line;
  max-width: 500rpx;
}

/* ── 消息行 ──────────────────────────── */
.msg-wrapper {
  display: flex;
  align-items: flex-start;
  margin-bottom: 28rpx;
  width: 100%;
}
.msg-left {
  justify-content: flex-start;
}
.msg-right {
  justify-content: flex-end;
}

/* 头像 */
.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #2d3436, #636e72);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.avatar text {
  font-size: 22rpx;
  color: #c8d6e5;
  font-weight: 600;
}
.avatar-user {
  background: linear-gradient(135deg, #3d4f5f, #576574);
}

/* ── 气泡 ────────────────────────────── */
.bubble {
  max-width: 72%;
  padding: 20rpx 28rpx;
  border-radius: 20rpx;
  word-break: break-word;
  overflow-wrap: break-word;
  flex-shrink: 1;
  box-sizing: border-box;
}
.bubble-du {
  background: rgba(255, 255, 255, 0.06);
  border-top-left-radius: 4rpx;
  margin-left: 16rpx;
}
.bubble-user {
  background: rgba(100, 160, 220, 0.18);
  border-top-right-radius: 4rpx;
  margin-right: 16rpx;
}
.bubble-text {
  font-size: 28rpx;
  line-height: 1.7;
  color: #d0d6e0;
  white-space: pre-wrap;
}

/* 加载动画 */
.bubble-loading {
  padding: 24rpx 36rpx;
}
.typing-dots {
  display: flex;
  gap: 10rpx;
}
.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.4);
  animation: blink 1.4s ease-in-out infinite;
}
.dot:nth-child(2) { animation-delay: 0.2s; }
.dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes blink {
  0%, 60%, 100% { opacity: 0.2; transform: scale(0.8); }
  30% { opacity: 1; transform: scale(1); }
}

/* ── 输入栏 ──────────────────────────── */
.input-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
  background: #0f0f1a;
  flex-shrink: 0;
}
.msg-input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 36rpx;
  font-size: 28rpx;
  color: #e0e0e0;
}
.send-btn {
  margin-left: 16rpx;
  padding: 0 32rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: linear-gradient(135deg, rgba(100, 160, 220, 0.5), rgba(80, 140, 200, 0.4));
  border: none;
  border-radius: 36rpx;
  font-size: 26rpx;
  color: #fff;
  font-weight: 500;
}
.send-btn[disabled] {
  opacity: 0.3;
}
